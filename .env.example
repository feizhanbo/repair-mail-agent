# Application
APP_ENV=dev
APP_NAME=repair-mail-agent
LOG_LEVEL=INFO

# Database
# Current phase uses root for database access. Replace change-me-root in private .env files only.
# URL-encode special characters in the DATABASE_URL password.
# Local development through SSH tunnel:
# DATABASE_URL=mysql+asyncmy://root:change-me-root@127.0.0.1:13307/repair_system_test
# Container runtime inside Docker Compose:
DB_NAME=repair_system_test
DATABASE_URL=mysql+asyncmy://root:change-me-root@mysql:3306/repair_system_test
DEV_DATABASE_URL=mysql+asyncmy://root:change-me-root@mysql:3306/repair_system_dev
# Optional explicit DB smoke test URL. Leave empty for normal unit-test runs.
DB_SMOKE_DATABASE_URL=
# 预留配置，当前未使用。后续如需Redis时启用。
REDIS_URL=redis://redis:6379/0

# MySQL container bootstrap values for docker-compose.yml（非 Python 配置，仅供 Docker 使用）
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=repair_system_dev

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# IMAP
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=rmatest1@accotest.com
IMAP_PASSWORD=
IMAP_POLL_INTERVAL_MINUTES=5
IMAP_FETCH_ENABLED=true
IMAP_FOLDER=INBOX
IMAP_FETCH_LIMIT=10
IMAP_UNSEEN_ONLY=true
IMAP_ARCHIVE_TO_OSS=true
IMAP_MAX_RETRIES=5
AUTO_FOLLOWUP_INTERVAL_MINUTES=5

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=rmatest1@accotest.com
SMTP_PASSWORD=

# OSS
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=acco-repair-mail-file
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_ORPHAN_MIN_AGE_HOURS=24
OSS_IO_CONCURRENCY=4

# AI
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_BASE_URL=https://api.deepseek.com
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_SECONDS=1.0
AI_MAX_INPUT_CHARS=12000
AI_PROMPT_VERSION=deepseek-v4-json-v1
AI_FULL_LOG_ENABLED=true
AI_FULL_LOG_RETENTION_DAYS=30
# AI_LOG_DIR defaults to backend/logs/ai
MAIL_PRECHECK_IRRELEVANT_MIN_CONFIDENCE=0.85
ATTACHMENT_MAX_AUTO_PARSE_BYTES=52428800
ATTACHMENT_MAX_ARCHIVE_BYTES=209715200
EMAIL_MAX_ARCHIVE_BYTES=524288000
EMAIL_MAX_ATTACHMENTS=50
INLINE_ATTACHMENT_MAX_BYTES=10485760
INLINE_IMAGE_MIN_PARSE_WIDTH=256
INLINE_IMAGE_MIN_PARSE_HEIGHT=128
ATTACHMENT_TEXT_MAX_CHARS=20000
PDF_MAX_PARSE_PAGES=15
PDF_PREVIEW_MAX_PAGES=5
MAIL_IO_CONCURRENCY=2
FILE_PARSE_CONCURRENCY=2

# Qwen（附件级文本与多模态解析）
QWEN_API_KEY=<CHANGE_ME>
QWEN_MODEL=qwen-plus
MULTIMODAL_PROVIDER=qwen
QWEN_VL_MODEL=qwen-vl-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# External relay placeholders (disabled until endpoint/auth/schema are provided)
RELAY_BASE_URL=
RELAY_API_KEY=
RELAY_SN_SYNC_ENABLED=false
RELAY_PUSH_ENABLED=false
RELAY_TIMEOUT_SECONDS=10

# SQL Server relay. Disabled means no external connection is attempted.
RELAY_SQLSERVER_ENABLED=false
RELAY_SQLSERVER_HOST=
RELAY_SQLSERVER_PORT=1433
RELAY_SQLSERVER_DATABASE=
RELAY_SQLSERVER_USER=
RELAY_SQLSERVER_PASSWORD=
RELAY_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
RELAY_SQLSERVER_ENCRYPT=true
RELAY_SQLSERVER_TRUST_SERVER_CERTIFICATE=false
RELAY_SQLSERVER_SN_SCHEMA=dbo
RELAY_SQLSERVER_SN_TABLE=
RELAY_SQLSERVER_SN_PRIMARY_KEY=
RELAY_SQLSERVER_SN_UPDATED_AT_COLUMN=
# JSON mapping: local sn_assets field -> SQL Server source column
RELAY_SQLSERVER_SN_COLUMN_MAP={"sn":"sn","customer_code":"customer_code","customer_name":"customer_name","material_code":"material_code","material_name":"material_name","asset_status":"asset_status"}
RELAY_SQLSERVER_RESULT_MODE=table
RELAY_SQLSERVER_RESULT_SCHEMA=dbo
RELAY_SQLSERVER_RESULT_TARGET=
RELAY_SQLSERVER_RESULT_UNIQUE_COLUMN=
RELAY_SQLSERVER_RESULT_UNIQUE_PAYLOAD_KEY=ticket_no
# JSON mapping: ticket snapshot path -> SQL Server target column or procedure parameter
RELAY_SQLSERVER_RESULT_COLUMN_MAP={}
RELAY_SQLSERVER_BATCH_SIZE=500
RELAY_SQLSERVER_SYNC_INTERVAL_MINUTES=5
RELAY_SQLSERVER_FULL_SYNC_HOUR=2

INTERNAL_EMAIL_DOMAINS=["accotest.com"]
DEVICE_RECEIPT_TRUSTED_SENDERS=[]
ROUTING_DOMESTIC_USERNAME=miya
ROUTING_FOREIGN_USERNAME=demi

# Business switches
EMAIL_ASYNC_ENABLED=false
SMTP_ASYNC_ENABLED=false
IMPORT_EXPORT_ASYNC_ENABLED=false
ASYNC_JOB_POLL_SECONDS=5
ASYNC_JOB_STALE_SECONDS=900
AUTO_SEND_ENABLED=false
AUTO_FOLLOWUP_ENABLED=false
RMA_AUTO_SEND_ENABLED=true
AUTO_APPLY_MIN_CONFIDENCE=0.85
AUTO_SEND_MIN_CONFIDENCE=0.85
# 白名单：仅向列表中的邮箱自动发送回复，JSON 数组格式
SMTP_RECIPIENT_WHITELIST=["rmatest2@accotest.com"]
MAX_FOLLOW_UP=3
CONFIDENCE_THRESHOLD=0.7
# 运行时配置文件路径（通常无需修改）
# RUNTIME_CONFIG_PATH=config/runtime_config.json

# RMA authorization PDF and automatic reply
# RMA AUTO V3.1 template/layout are integrity checked at startup and before every generation.
# RMA_PDF_TEMPLATE_PATH defaults to backend/app/resources/rma_pdf/rma_authorization_auto_v3_1.pdf
# RMA_PDF_LAYOUT_PATH defaults to backend/app/resources/rma_pdf/layout_v3_1_auto.yaml
# Set this to a licensed Noto Sans CJK font in deployment; no font is extracted from reference PDFs.
RMA_CJK_FONT_PATH=
RMA_PDF_DEFAULT_CURRENCY=
RMA_PDF_DEFAULT_DELIVERY_FEE=one-way charge/单次收费
RMA_PDF_DEFAULT_REPAIR_FEE=free of charge/免费
RMA_PDF_DEFAULT_TOTAL_COST=0

# Seed data
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-admin
DEFAULT_ADMIN_REAL_NAME="System Administrator"
DEFAULT_ADMIN_EMAIL=admin@example.com

# Frontend（非 Python 配置，仅供前端使用）
VITE_API_BASE_URL=/api/v1
VITE_EMAIL_ASYNC_ENABLED=false
VITE_SMTP_ASYNC_ENABLED=false
VITE_IMPORT_EXPORT_ASYNC_ENABLED=false
