# Application
APP_ENV=dev
APP_NAME=repair-mail-agent
APP_VERSION=0.1.0
COMMIT_SHA=unknown
NGINX_HTTP_PORT=80
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_STDOUT_ENABLED=true
LOG_FILE_ENABLED=false
# Production Docker overrides these to /app/logs/runtime and true.
LOG_DIR=backend/logs/runtime
LOG_ROTATION_WHEN=midnight
LOG_RETENTION_DAYS=30
LOG_MAX_MESSAGE_LENGTH=8192
LOG_INCLUDE_TRACEBACK=true
HTTP_ACCESS_LOG_ENABLED=true
SLOW_REQUEST_THRESHOLD_MS=3000
SLOW_DB_THRESHOLD_MS=1000
SLOW_EXTERNAL_THRESHOLD_MS=5000
# Only proxy peers in these CIDRs may supply X-Real-IP/X-Forwarded-For.
TRUSTED_PROXY_CIDRS=[]

# Database
# Current phase uses root for database access. Replace change-me-root in private .env files only.
# URL-encode special characters in the DATABASE_URL password.
# Local development through SSH tunnel:
# DATABASE_URL=mysql+asyncmy://root:change-me-root@127.0.0.1:13307/repair_system_test
# Container runtime inside Docker Compose:
DATABASE_URL=mysql+asyncmy://root:change-me-root@mysql:3306/repair_system_test
DEV_DATABASE_URL=mysql+asyncmy://root:change-me-root@mysql:3306/repair_system_dev
# Optional explicit DB smoke test URL. Leave empty for normal unit-test runs.
DB_SMOKE_DATABASE_URL=
# Force-delete and Gold Replay additionally require APP_ENV=dev/test and an
# exact DATABASE_URL database-name match against this explicit allowlist.
DESTRUCTIVE_TEST_DATABASE_ALLOWLIST=["repair_system_test","AIRMA_test"]
# 预留配置，当前未使用。后续如需Redis时启用。
REDIS_URL=redis://redis:6379/0

# MySQL container bootstrap values for docker-compose.yml（非 Python 配置，仅供 Docker 使用）
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=repair_system_dev

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# IMAP
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=rmatest1@accotest.com
IMAP_PASSWORD=
IMAP_POLL_INTERVAL_MINUTES=5
IMAP_FETCH_ENABLED=true
IMAP_FOLDER=INBOX
IMAP_FETCH_LIMIT=10
IMAP_INITIAL_SYNC_START_AT=2026-08-01T00:00:00
IMAP_INITIAL_BATCH_SIZE=50
IMAP_INCREMENTAL_LIMIT=20
IMAP_FETCH_BATCH_SIZE=10
# Compatibility-only UI field. UID cursor synchronization does not use UNSEEN.
IMAP_UNSEEN_ONLY=false
IMAP_ARCHIVE_TO_OSS=true
IMAP_MAX_RETRIES=5
AUTO_FOLLOWUP_INTERVAL_MINUTES=5

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=rmatest1@accotest.com
SMTP_PASSWORD=
SMTP_MAX_CONNECTIONS=2
SMTP_MESSAGES_PER_CONNECTION=20
SMTP_CONNECTION_MAX_AGE_SECONDS=600
SMTP_IDLE_TIMEOUT_SECONDS=60
SMTP_CONNECT_TIMEOUT_SECONDS=20
SMTP_SEND_TIMEOUT_SECONDS=60
SMTP_RETRY_LIMIT=3
SMTP_RETRY_BACKOFF_SECONDS=[30,120,300]
SMTP_RATE_LIMIT_PER_MINUTE=60
SMTP_SENT_FOLDER=Sent
# JSON list of all system-owned aliases filtered before AI classification.
SYSTEM_SENDER_ADDRESSES=[]

# OSS
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=acco-repair-mail-file
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_ORPHAN_MIN_AGE_HOURS=24
OSS_IO_CONCURRENCY=4

# AI
# Business-task model selection lives in backend/config/llm_routes.yaml.
# LLM_ROUTES_FILE defaults to backend/config/llm_routes.yaml resolved by the application.
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_SECONDS=1.0
AI_MAX_INPUT_CHARS=12000
AI_PROMPT_VERSION=deepseek-v4-json-v1
AI_FULL_LOG_ENABLED=true
AI_FULL_LOG_RETENTION_DAYS=30
# AI_LOG_DIR defaults to backend/logs/ai
MAIL_PRECHECK_IRRELEVANT_MIN_CONFIDENCE=0.85
ATTACHMENT_MAX_AUTO_PARSE_BYTES=52428800
ATTACHMENT_MAX_ARCHIVE_BYTES=209715200
EMAIL_MAX_ARCHIVE_BYTES=524288000
EMAIL_MAX_ATTACHMENTS=50
INLINE_ATTACHMENT_MAX_BYTES=10485760
INLINE_IMAGE_MIN_PARSE_WIDTH=256
INLINE_IMAGE_MIN_PARSE_HEIGHT=128
ATTACHMENT_TEXT_MAX_CHARS=20000
PDF_MAX_PARSE_PAGES=15
PDF_PREVIEW_MAX_PAGES=5
MAIL_IO_CONCURRENCY=2
FILE_PARSE_CONCURRENCY=2

# Qwen（附件级文本与多模态解析）
QWEN_API_KEY=<CHANGE_ME>
QWEN_MODEL=qwen-plus
MULTIMODAL_PROVIDER=qwen
QWEN_VL_MODEL=qwen-vl-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# External relay placeholders (disabled until endpoint/auth/schema are provided)
RELAY_BASE_URL=
RELAY_ADAPTER=sqlserver
TEST_RELAY_BASE_URL=
TEST_RELAY_TOKEN=
RUN_REAL_MAIL_INTEGRATION_TESTS=false

# Repeatable gold-mail regression. Keep both passwords in the ignored local .env only.
E2E_GOLD_RUN_ENABLED=false
E2E_RMATEST2_IMAP_HOST=imaphz.qiye.163.com
E2E_RMATEST2_IMAP_PORT=993
E2E_RMATEST2_IMAP_USE_SSL=true
E2E_RMATEST2_IMAP_USER=rmatest2@accotest.com
E2E_RMATEST2_IMAP_PASSWORD=
E2E_RMATEST2_IMAP_FOLDER=INBOX
E2E_RMATEST2_SMTP_HOST=smtphz.qiye.163.com
E2E_RMATEST2_SMTP_PORT=465
E2E_RMATEST2_SMTP_USE_SSL=true
E2E_RMATEST2_SMTP_USER=rmatest2@accotest.com
E2E_RMATEST2_SMTP_PASSWORD=
RELAY_API_KEY=
RELAY_SN_SYNC_ENABLED=false
RELAY_PUSH_ENABLED=false
RELAY_TIMEOUT_SECONDS=10

# SQL Server relay. Disabled means no external connection is attempted.
RELAY_SQLSERVER_ENABLED=false
RELAY_SQLSERVER_HOST=
RELAY_SQLSERVER_PORT=1433
RELAY_SQLSERVER_DATABASE=
RELAY_SQLSERVER_USER=
RELAY_SQLSERVER_PASSWORD=
RELAY_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
RELAY_SQLSERVER_ENCRYPT=true
RELAY_SQLSERVER_TRUST_SERVER_CERTIFICATE=false
RELAY_SQLSERVER_SN_SCHEMA=dbo
RELAY_SQLSERVER_SN_TABLE=oins_rma
RELAY_SQLSERVER_SN_PRIMARY_KEY=
RELAY_SQLSERVER_SN_UPDATED_AT_COLUMN=
# JSON mapping: local sn_assets field -> SQL Server source column.
# Optional local fields: service_tracking_card_no, parent_sn, top_sn, parent_material_code, top_material_code.
RELAY_SQLSERVER_SN_COLUMN_MAP={"ins_id":"insID","sn":"internalSN","customer_code":"customer","customer_name":"custmrName","material_code":"ITEMCODE","material_name":"ITEMNAME","parent_material_code":"U_FatherItem","parent_sn":"U_FatherSerialNum","top_material_code":"U_topitemcode","top_sn":"U_TOPSN","warranty_end_date":"ExpDate"}
RELAY_SQLSERVER_REQUEST_SCHEMA=dbo
RELAY_SQLSERVER_REQUEST_TABLE=oscl_rma
RELAY_SQLSERVER_RESULT_SCHEMA=dbo
RELAY_SQLSERVER_RESULT_TABLE=oscl_print
RELAY_SQLSERVER_REQUEST_ID_COLUMN=RequestID
# Legacy audit only; new SAP integration does not read or write CallID.
RELAY_SQLSERVER_CALL_ID_COLUMN=CallID
RELAY_SQLSERVER_RMA_COLUMN=U_CustomerNum
# RMA1/RMA2 use RequestID CHAR(36) NOT NULL UNIQUE. AIRMA never writes RMA2.
RELAY_SQLSERVER_BATCH_SIZE=500
RELAY_SQLSERVER_SYNC_INTERVAL_MINUTES=5
RELAY_SQLSERVER_FULL_SYNC_HOUR=2
RELAY_SQLSERVER_RMA_POLL_INTERVAL_SECONDS=300
RELAY_SQLSERVER_RMA_TIMEOUT_WORKING_HOURS=8
RELAY_SUBMIT_UNKNOWN_CONFIRM_SECONDS=300
# Keep empty until SAP's daily refresh completion time is confirmed by IT.
RELAY_SN_SYNC_CRON=
RELAY_SN_COUNT_CHANGE_GUARD_PERCENT=5
RELAY_SN_SNAPSHOT_MAX_AGE_HOURS=36
RMA_DEFAULT_BEIJING_COMPANY=北京华峰测控技术股份有限公司
RMA_DEFAULT_BEIJING_ADDRESS=北京市海淀区丰豪东路9号院5号楼
RMA_DEFAULT_BEIJING_CONTACT=李连荣
RMA_DEFAULT_BEIJING_PHONE=010-63725600-193
RMA_DEFAULT_BEIJING_POSTAL_CODE=100094
RMA_DEFAULT_TIANJIN_COMPANY=华峰测控技术（天津）有限责任公司
RMA_DEFAULT_TIANJIN_ADDRESS=天津市滨海新区生态城川博道华峰测控1201号
RMA_DEFAULT_TIANJIN_CONTACT=郭洋（收）
RMA_DEFAULT_TIANJIN_PHONE=022-67253518-8108
RMA_DEFAULT_TIANJIN_POSTAL_CODE=

INTERNAL_EMAIL_DOMAINS=["accotest.com"]
DEVICE_RECEIPT_TRUSTED_SENDERS=[]
ROUTING_DOMESTIC_USERNAME=miya
ROUTING_FOREIGN_USERNAME=demi

# Business switches
EMAIL_ASYNC_ENABLED=false
SMTP_ASYNC_ENABLED=false
MAIL_WORKER_ENABLED=true
MAIL_SCHEDULER_IN_API=false
IMPORT_EXPORT_ASYNC_ENABLED=false
ASYNC_JOB_POLL_SECONDS=5
ASYNC_JOB_STALE_SECONDS=900
AUTO_SEND_ENABLED=false
AUTO_FOLLOWUP_ENABLED=false
RMA_AUTO_SEND_ENABLED=true
AUTO_APPLY_MIN_CONFIDENCE=0.85
AUTO_SEND_MIN_CONFIDENCE=0.85
# 白名单：仅向列表中的邮箱自动发送回复，JSON 数组格式
SMTP_RECIPIENT_WHITELIST=["rmatest2@accotest.com"]
MAX_FOLLOW_UP=3
CONFIDENCE_THRESHOLD=0.7
# 运行时配置文件路径（通常无需修改）
# RUNTIME_CONFIG_PATH=config/runtime_config.json

# RMA authorization PDF and automatic reply
# RMA AUTO V3.1 template/layout are integrity checked at startup and before every generation.
# RMA_PDF_TEMPLATE_PATH defaults to backend/app/resources/rma_pdf/rma_authorization_v1.pdf
# RMA_PDF_LAYOUT_PATH defaults to backend/app/resources/rma_pdf/layout_v3_2_reference.yaml
# Set this to a licensed Noto Sans CJK font in deployment; no font is extracted from reference PDFs.
RMA_CJK_FONT_PATH=
RMA_PDF_DEFAULT_CURRENCY=
RMA_PDF_DEFAULT_DELIVERY_FEE=one-way charge/单次收费
RMA_PDF_DEFAULT_REPAIR_FEE=free of charge/免费
RMA_PDF_DEFAULT_TOTAL_COST=0
RMA_PDF_TYPICAL_MAX_BYTES=500000
RMA_PDF_MAX_BYTES=2000000

# Seed data
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-admin
DEFAULT_ADMIN_REAL_NAME="System Administrator"
DEFAULT_ADMIN_EMAIL=admin@example.com

# Frontend（非 Python 配置，仅供前端使用）
VITE_API_BASE_URL=/api/v1
VITE_EMAIL_ASYNC_ENABLED=false
VITE_SMTP_ASYNC_ENABLED=false
VITE_IMPORT_EXPORT_ASYNC_ENABLED=false
